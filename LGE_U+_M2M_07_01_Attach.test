lowingActionId="1" name="Assigned"/></action><action xsi:type="compoundAction" id="49" name="IPSecConfiguration" description="This test demonstrates EUTRA-IMS Mobile Terminated SMS with EUTRA-NR Measurements and ENDC split bearer addition, in particular the following operations: 1. LTE Attach on PDN1 with UE capability check for ENDC. 2. IMS Registration on PDN2 over IPv4/IPv6 and IPSEC ON/OFF (PDN Type and IPSEC configurable) 3. MT SMS over IPv4/IPv6. 4. ENDC addition - Move the default MCG bearer to an SCG bearer after NR measurement (MN terminated, FR1 Band). 5. SCG Release. 6. LTE Detach. 7. End of test."><action xsi:type="controlAction" id="0" name="Start" controlActionType="START"><outcome id="0" followingActionId="4" name=""/></action><action xsi:type="controlAction" id="1" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>1</id></parameter></action><action xsi:type="controlAction" id="2" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>2</id></parameter></action><action xsi:type="controlAction" id="3" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>3</id></parameter></action><action xsi:type="procedureAction" id="4" name="Get Key as Bit String" procedureActionType="General" procedureGroupName="Security Procedures" procedureLibraryName="CommonUtilitiesLib"><parameter xsi:type="PlGetKeyBit_RtdParameter.type" procedureLibraryName="CommonUtilitiesLib"><keySet><value->8</value-></keySet><key><value-><iK><value->NULL</value-></iK></value-></key></parameter><outcome id="1" followingActionId="43" name="OK" outputParameterType="PlGetKeyBit_ReturnData.type"/><outcome id="2" followingActionId="-1" name="System Error" outputParameterType="PlGetKeyBit_ReturnData.type"/><outcome id="3" followingActionId="-1" name="Invalid" outputParameterType="PlGetKeyBit_ReturnData.type"/><ass