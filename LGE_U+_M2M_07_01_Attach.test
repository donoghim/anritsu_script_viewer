ion" id="0" name="Start" controlActionType="START"><outcome id="0" followingActionId="8" name=""/></action><action xsi:type="controlAction" id="1" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>1</id></parameter></action><action xsi:type="controlAction" id="2" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>2</id></parameter></action><action xsi:type="controlAction" id="3" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>3</id></parameter></action><action xsi:type="controlAction" id="4" name="Assignment" controlActionType="ASSIGNMENT"><parameter xsi:type="AssignmentType"><ControlVariableList xsi:type="ControlVariableListType"/><AssignmentExpressionList xsi:type="AssignmentExpressionListType"><AssignmentExpression xsi:type="ExpressionType">regInfo = append("&lt;?xml version='1.0'?&gt;&lt;reginfo xmlns='urn:ietf:params:xml:ns:reginfo' version='0' state='full'&gt;&lt;registration aor='", aor, "' id='a100' state='", state, "'&gt;&lt;contact id='980' state='", state, "' event='", event, "'&gt;&lt;uri&gt;", uri, "&lt;/uri&gt;&lt;/contact&gt;&lt;/registration&gt;&lt;registration aor='", aor2, "' id='a101' state='", state,"'&gt;&lt;contact id='981' state='", state, "' event='", eventA101, "'&gt;&lt;uri&gt;", uri, "&lt;/uri&gt;&lt;/contact&gt;&lt;/registration&gt;&lt;/reginfo&gt;")</AssignmentExpression></AssignmentExpressionList></parameter><outcome id="1" followingActionId="6" name="Assigned"/></action><action xsi:type="controlAction" id="6" name="Assignment" controlActionType="ASSIGNMENT"><parameter xsi:type="AssignmentType"><ControlVariableList xsi:type="ControlVariableListType"><ControlVariable xsi:type="VariableAssignmentType" name="oResponseBody"><procedureLibrary>ImsSignalingLib</procedureLibrary><nodePath>SendResponse/response/value-/body</nodePath><defaultValue><SendR