="http://www.w3.org/2001/XMLSchema" name="StartTimerDurationChoiceType"><restriction base="xs:integer"><xs:minInclusive value="100"/></restriction></xs:simpleType><xs:simpleType xmlns:xs="http://www.w3.org/2001/XMLSchema" name="LoopParameterChoiceType"><restriction base="xs:integer"/></xs:simpleType></VariableSchema><displayInformation><layoutInformation><a id="2" x="540" y="82" row="2"/><a id="0" x="540" y="-147" row="1"/><a id="4" x="542" y="-20" row="0"/><l o="0" a="4" s="false"><w x="540" y="-125"/><w x="540" y="-115"/><w x="540" y="-115"/><w x="542" y="-115"/><w x="542" y="-115"/><w x="542" y="-115"/><w x="542" y="-55"/><w x="542" y="-45"/></l><l o="2" a="2" s="false"><w x="542" y="6"/><w x="542" y="16"/><w x="542" y="16"/><w x="540" y="16"/><w x="540" y="16"/><w x="540" y="16"/><w x="540" y="59"/><w x="540" y="69"/></l><Note x="-181" y="-532" width="571" height="845"><Text><![CDATA[Following parameters are initialized in the procedure:

Parameter        : User_Supplied_Sqn_Rand
Description       : Parameter controls whether the values of SQN and RAND are used defined or automatically generated
                           by library.
Possible values : True, False
Default value    : False		

Parameter        : EpsAttachResult
Description       : EPS attach result sent in the Attach Accept message. Value of "Auto" implies that UE requested attach 
                            type is accepted.
Possible values : EpsOnly, Combined, Auto
Default value    : Auto

Parameter        : BandIndicator
Description       : ECell Band indicator
Possible values : 
Default value    : 4

Parameter        : DLEarfcn
Description       : Downlink Earfcn value 
Possible values : 
Default value    : 2100

Parameter        : SQN
Description       : Sequence Number to be used in Authentication procedure. The parameter value is only used if
                           User_Supplied_Sqn_Rand is set to False
Possible values : 
Default value    : 000000000000

Parameter        : RAND
Description       : Random number to be used in Authentication procedure. The parameter value is only used if
                           User_Supplied_Sqn_Rand is set to False
Possible values : 
Default value    : 0123456789abcdef0123456789abcdef

Parameter        : K
Description       : Shared Secret  key to be used in Authentication procedure. 
Possible values : 
Default value    : 00112233445566778899aabbccddeeff

Parameter        : RRCintegrityAlgorithm
Description       : Integrity Algorithm to be used for RRC. 
Possible values : null, Snow3g, AES
Default value    : Snow3g

Parameter        : RRCcipheringAlgorithm
Description       : Ciphering Algorithm to be used for RRC. 
Possible values : null, Snow3g, AES
Default value    : null

Parameter        : NASintegrityAlgorithm
Description       : Integrity Algorithm to be used for NAS. 
Possible values : null, Snow3g, AES
Default value    : Snow3g

Parameter        : NAScipheringAlgorithm
Description       : Ciphering Algorithm to be used for NAS. 
Possible values : null, Snow3g, AES
Default value    : null]]></Text><NoteLink anchorId="4" anchorIdType="1"><w x="405" y="-109"/><w x="512" y="-26"/></NoteLink></Note></layoutInformation></displayInformation><parameter xsi:type="CompoundParametersType"><ParameterAssignment xsi:type="ParameterAssignmentType"><ParameterName readOnly="true" xsi:type="VariableNameView">p_AuthenticationParameters</ParameterName><ParameterValue default_able="true" variable_able="ALL_VARIABLES" xsi:type="anonType:  i=-2363 element, class com.anritsu.eu.rtd.engine.dom.schema.ComplexSchemaType LteL3Lib.TypeDefinitions.xsd"><defaultValue><AuthenticationRequest xsi:type="AuthenticationRequest_RtdParameter.type"><Configuration><value-><authenticationAlgorithm><value-><umtsTest><value-><k><value->00112233445566778899AABBCCDDEEFF</value-></k><rand><value->A3DE0C6D363E30C364A4078F1BF8D577</value-></rand><sqn><valuemodify->OMIT</valuemodify-></sqn><amf><value->D555</value-></amf><xresSize><valuemodify->OMIT</valuemodify-></xresSize></value-></umtsTest></value-></authenticationAlgorithm></value-></Configuration></AuthenticationRequest></defaultValue><nodePath>AuthenticationRequest/Configuration/value-/authenticationAlgorithm</nodePath><procedureLibrary>LteL3Lib</procedureLibrary></ParameterValue></ParameterAssignment><ParameterAssignment xsi:type="ParameterAssignmentType"><ParameterName readOnly="true" xsi:type="VariableNameView">p_DlEarfcn_Cell1</ParameterName><ParameterValue default_able="true" variable_able="true" xsi:type="ARFCN_ValueEUTRA_r9.type" variable_substituted="vg_Cell1_Channel"><defaultValue><ConfigureSystem xsi:type="ConfigureSystem_RtdParameter.type"><CellGroup><value-><elems-><value-><Cells><value-><elems-><value-><lte><value-><Common><value-><frequency><value-><dlEarfcn><variable->vg_Cell1_Channel</variable-></dlEarfcn></value-></frequency></value-></Common></value-></lte></value-></elems-></value-></Cells></value-></elems-></value-></CellGroup></ConfigureSystem></defaultValue><nodePath>ConfigureSystem/CellGroup/val