><action xsi:type="compoundAction" id="657" name="A_IMS_RequestAuthentication" description="This test demonstrates EUTRA-IMS Mobile Terminated SMS with EUTRA-NR Measurements and ENDC split bearer addition, in particular the following operations: 1. LTE Attach on PDN1 with UE capability check for ENDC. 2. IMS Registration on PDN2 over IPv4/IPv6 and IPSEC ON/OFF (PDN Type and IPSEC configurable) 3. MT SMS over IPv4/IPv6. 4. ENDC addition - Move the default MCG bearer to an SCG bearer after NR measurement (MN terminated, FR1 Band). 5. SCG Release. 6. LTE Detach. 7. End of test."><action xsi:type="controlAction" id="0" name="Start" controlActionType="START"><outcome id="0" followingActionId="46" name=""/></action><action xsi:type="controlAction" id="1" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>1</id></parameter></action><action xsi:type="controlAction" id="2" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>2</id></parameter></action><action xsi:type="controlAction" id="3" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>3</id></parameter></action><action xsi:type="controlAction" id="37" name="Conditional Branch" controlActionType="CONDITIONAL_BRANCH"><parameter xsi:type="ConditionalBranchType"><ConditionalExpression xsi:type="ExpressionType">doIPSec == true</ConditionalExpression></parameter><outcome id="76" followingActionId="49" name="True"/><outcome id="77" followingActionId="40" name="False"/></action><action xsi:type="compoundAction" id="43" name="AuthenticationHeader" description="This test demonstrates EUTRA-IMS Mobile Terminated SMS with EUTRA-NR Measurements and ENDC split bearer addition, in particular the following operations: 1. LTE Attach on PDN1 with UE capability check for ENDC. 2. IMS Registration on PDN2 over IPv4/IPv6 and IPSEC ON/OFF (PDN Type and I