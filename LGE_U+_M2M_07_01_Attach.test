G Release. 6. LTE Detach. 7. End of test."><action xsi:type="controlAction" id="0" name="Start" controlActionType="START"><outcome id="0" followingActionId="4" name=""/></action><action xsi:type="controlAction" id="1" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>1</id></parameter></action><action xsi:type="controlAction" id="2" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>2</id></parameter></action><action xsi:type="controlAction" id="3" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>3</id></parameter></action><action xsi:type="controlAction" id="4" name="Assignment" controlActionType="ASSIGNMENT"><parameter xsi:type="AssignmentType"><ControlVariableList xsi:type="ControlVariableListType"/><AssignmentExpressionList xsi:type="AssignmentExpressionListType"><AssignmentExpression xsi:type="ExpressionType">oTag = java(Math.getModuloValue(java(Math.rand(l_omitted)), 4294967295))</AssignmentExpression></AssignmentExpressionList></parameter><outcome id="1" followingActionId="1" name="Assigned"/></action><testDeclarations><parameters><parameter><name>oTag</name><description></description><acronym>acr</acronym><scope>LOCAL</scope><defaultValue><value xsi:type=":string" Property="OMIT"/></defaultValue><writeRule><replace sourceIdentifies="NODE(S)"><destinationXPath>/root/datamodel/public/variables/SecondPdn_IMS_Registration_854/A_IMS_Registration_820/A_IMS_RequestAuthentication_657/IPSecConfiguration_49/GenerateTag_18/oTag/value-</destinationXPath><sourceXPath>/root/variableValue/value-</sourceXPath></replace></writeRule><createRule><ruleGroup><create elementName="oTag" createNodeType="Element"><parentXPath>/root/datamodel/public/variables/SecondPdn_IMS_Registration_854/A_IMS_Registration_820/A_IMS_RequestAuthentication_657/IPSecConfiguration_49/GenerateTag_18</parentXPath