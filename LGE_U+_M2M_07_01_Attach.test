name="End"/><terminator id="2" index="1" acronym="Err" name="Error"/><terminator id="3" index="2" acronym="SE" name="SystemError"/></terminators><caching/></action><action xsi:type="compoundAction" id="670" name="A_IMS_Notify" description="This test demonstrates EUTRA-IMS Mobile Terminated SMS with EUTRA-NR Measurements and ENDC split bearer addition, in particular the following operations: 1. LTE Attach on PDN1 with UE capability check for ENDC. 2. IMS Registration on PDN2 over IPv4/IPv6 and IPSEC ON/OFF (PDN Type and IPSEC configurable) 3. MT SMS over IPv4/IPv6. 4. ENDC addition - Move the default MCG bearer to an SCG bearer after NR measurement (MN terminated, FR1 Band). 5. SCG Release. 6. LTE Detach. 7. End of test."><action xsi:type="controlAction" id="0" name="Start" controlActionType="START"><outcome id="0" followingActionId="12" name=""/></action><action xsi:type="controlAction" id="17" name="Assignment" controlActionType="ASSIGNMENT"><parameter xsi:type="AssignmentType"><ControlVariableList xsi:type="ControlVariableListType"><ControlVariable xsi:type="VariableAssignmentType"><pCscfAddress xsi:type=":string" variable_able="ALL_VARIABLES" variable_substituted="vg_A_IMS_p_cscfAddress"/></ControlVariable></ControlVariableList><AssignmentExpressionList xsi:type="AssignmentExpressionListType"><AssignmentExpression xsi:type="ExpressionType">contactURI = append("sip:[", contactName, "]:", contactPort)</AssignmentExpression></AssignmentExpressionList></parameter><outcome id="29" followingActionId="20" name="Assigned"/></action><action xsi:type="controlAction" id="1" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>1</id></parameter></action><action xsi:type="controlAction" id="16" name="Conditional Branch" controlActionType="CONDITIONAL_BRANCH"><parameter xsi:type="ConditionalBranchType"><ControlVariable xsi:type="VariableAssignmentType"><pIpVersion xsi:type=":string" variable_able="ALL_VARIABLES">IPv