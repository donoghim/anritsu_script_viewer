rminatorId="2"/><terminators><terminator id="1" index="0" acronym="End" name="End"/><terminator id="2" index="1" acronym="Err" name="Error"/><terminator id="3" index="2" acronym="SE" name="SystemError"/></terminators><caching/></action><action xsi:type="controlAction" id="0" name="Start" controlActionType="START"><outcome id="0" followingActionId="823" name=""/></action><action xsi:type="controlAction" id="850" name="MMI Prompt" controlActionType="MMI_PROMPT_ACTION"><parameter xsi:type="MmiPromptType"><Prompt xsi:type="VariableChoiceType" variable_able="USER_VARIABLE_ONLY">Data enable on the phone</Prompt></parameter><outcome id="2009" followingActionId="849" name="MMI Prompt Sent"/><outcome id="2010" followingActionId="-1" name="System Error"/></action><action xsi:type="compoundAction" id="820" name="A_IMS_Registration" description="This test demonstrates EUTRA-IMS Mobile Terminated SMS with EUTRA-NR Measurements and ENDC split bearer addition, in particular the following operations: 1. LTE Attach on PDN1 with UE capability check for ENDC. 2. IMS Registration on PDN2 over IPv4/IPv6 and IPSEC ON/OFF (PDN Type and IPSEC configurable) 3. MT SMS over IPv4/IPv6. 4. ENDC addition - Move the default MCG bearer to an SCG bearer after NR measurement (MN terminated, FR1 Band). 5. SCG Release. 6. LTE Detach. 7. End of test."><action xsi:type="controlAction" id="0" name="Start" controlActionType="START"><outcome id="0" followingActionId="648" name=""/></action><action xsi:type="compoundAction" id="669" name="A_IMS_AcceptSubscription" description="This test demonstrates EUTRA-IMS Mobile Terminated SMS with EUTRA-NR Measurements and ENDC split bearer addition, in particular the following operations: 1. LTE Attach on PDN1 with UE capability check for ENDC. 2. IMS Registration on PDN2 over IPv4/IPv6 and IPSEC ON/OFF (PDN Type and IPSEC configurable) 3. MT SMS over IPv4/IPv6. 4. ENDC addition - Move the default MCG bearer to an SCG bearer after NR measurement (MN terminated, FR1 Ba