sionListType"><AssignmentExpression xsi:type="ExpressionType">contactURI = append("sip:", contactName, ":", contactPort)</AssignmentExpression></AssignmentExpressionList></parameter><outcome id="18" followingActionId="21" name="Assigned"/></action><action xsi:type="controlAction" id="12" name="Assignment" controlActionType="ASSIGNMENT"><parameter xsi:type="AssignmentType"><ControlVariableList xsi:type="ControlVariableListType"><ControlVariable xsi:type="VariableAssignmentType"><contactName xsi:type=":string" variable_able="ALL_VARIABLES" variable_substituted="receivedRegister.request.headers.contact.contactBody.contactAddresses.elems-[1].addressField.nameAddr.addrSpec.components.sip.hostPort.host"/></ControlVariable><ControlVariable xsi:type="VariableAssignmentType"><contactPort xsi:type=":string" variable_able="ALL_VARIABLES" variable_substituted="receivedRegister.request.headers.contact.contactBody.contactAddresses.elems-[1].addressField.nameAddr.addrSpec.components.sip.hostPort.portField"/></ControlVariable><ControlVariable xsi:type="VariableAssignmentType"><publicUserIdHost xsi:type=":string" variable_able="ALL_VARIABLES" variable_substituted="receivedRegister.request.headers.fromField.addressField.nameAddr.addrSpec.components.sip.hostPort.host"/></ControlVariable><ControlVariable xsi:type="VariableAssignmentType"><publicUserIdName xsi:type=":string" variable_able="ALL_VARIABLES" variable_substituted="receivedRegister.request.headers.fromField.addressField.nameAddr.addrSpec.components.sip.userInfo.userOrTelephoneSubscriber"/></ControlVariable><ControlVariable xsi:type="VariableAssignmentType"><vl_transport xsi:type=":string" variable_able="ALL_VARIABLES" variable_substituted="pSendNotify.request.headers.via.viaBody.elems-[1].sentProtocol.transport"/></ControlVariable></ControlVariableList><AssignmentExpressionList xsi:type="AssignmentExpressionListType"/></parameter><outcome id="19" followingActionId="16" name="Assigned"/></action><action xsi:type="compoundAction" id="15" name="GenerateNotifyRegInfo" description="This test demonstrates EUTRA-IMS Mobile Terminated SMS with EUTRA-NR Measurements and ENDC split bearer addition, in particular the following operations: 1. LTE Attach on PDN1 with UE capability check for ENDC. 2. IMS Registration on PDN2 over IPv4/IPv6 and IPSEC ON/OFF (PDN Type and IPSEC configurable) 3. MT SMS over IPv4/IPv6. 4. ENDC addition - Move the default MCG bearer to an SCG bearer after NR measurement (MN terminated, FR1 Band). 5. SCG Release. 6. LTE Detach. 7. End of test."><action xsi:type="controlAction" id="0" name="Start" controlActionType="START"><outcome id="0" followingActionId="8" name=""/></action><action xsi:type="controlAction" id="1" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>1</id></parameter></action><action xsi:type="controlAction" id="2" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>2</id></parameter></action><action xsi:type="controlAction" id="3" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>3</id></parameter></action><action xsi:type="controlAction" id="4" name="Assignment" controlActionType="ASSIGNMENT"><parameter xsi:type="AssignmentType"><ControlVariableList xsi:type="ControlVariableListType"/><AssignmentExpressionList xsi:type="AssignmentExpressionListType"><AssignmentExpression xsi:type="ExpressionType">regInfo = append("&lt;?xml version='1.0'?&gt;&lt;reginfo xmlns='urn:ietf:params:xml:ns:reginfo' version='0' state='full'&gt;&lt;registration aor='", aor, "' id='a100' state='", state, "'&gt;&lt;contact id='980' state='", state, "' event='", event, "'&gt;&lt;uri&gt;", uri, "&lt;/uri&gt;&lt;/contact&gt;&lt;/registration&gt;&lt;registration aor='", aor2, "' id='a101' state='", state,"'&gt;&lt;contact id='981' state='", state, "' event='", eventA101, "'&gt;&lt;uri&gt;", uri, "&lt;/uri&gt;&lt;/contact&gt;&lt;/registration&gt;&lt;/reginfo&gt;")</AssignmentExpression></AssignmentExpressionList></parameter><outcome id="1" followingActionId="6" name="Assigned"/></action><action xsi:type="controlAction" id="6" name="Assignment" controlActionType="ASSIGNMENT"><parameter xsi:type="AssignmentType"><ControlVariableList xsi:type="ControlVariableListType"><ControlVariable xsi:type="VariableAssignmentType" name="oResponseBody"><procedureLibrary>ImsSignalingLib</procedureLibrary><nodePath>SendResponse/response/value-/body</nodePath><defaultValue><SendResponse xsi:type="SendResponse_RtdParameter.type"><response><value-><body><value-><xml><variable->regInfo</variable-></xml></value-></body></value-></response></SendResponse></defaultValue></ControlVariable></ControlVariableList><AssignmentExpressionList xsi:type="AssignmentExpressionListType"/></parameter><outcome id="3" followingActionId="1" name="Assigned"/></action><action xsi:type="controlAction" id="8" name="Conditional Branch" controlActionType="CONDITIONAL_BRANCH"><parameter xsi:type="ConditionalBranchType"><ConditionalExpression xsi:type="ExpressionType">state == "active"</ConditionalExpression></parameter><outcome id="5" followingActionId="4" name="True"/><outcome id="6" followingActionId="9" name="False"/></action><action xsi:type="controlAction" id="9" name="Assignment" controlActionType="ASSIGNMENT"><parameter xsi:type="AssignmentType"><ControlVariableList xsi:type="ControlVariableListType"><ControlVariable xsi:type="VariableAssignmentType"><eventA101 xsi:type=":string" variable_able="ALL_VARIABLES">rejected</eventA101></ControlVariable></ControlVariableList><AssignmentExpressionList xsi:type="AssignmentExpressionListType"/></parameter><outcome id="7" followingActionId="4" name="Assigned"/></action><testDeclarations><parameters><parameter><name>aor</name><description></description><acronym>acr</acronym><scope>LOCAL</scope><defaultValue><value xsi:type=":string" Property="OMIT"/></defaultValue