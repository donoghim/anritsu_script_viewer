atorId="2"/><outcome id="95" followingActionId="-1" terminatorId="3"/><terminators><terminator id="1" index="0" acronym="End" name="End"/><terminator id="2" index="1" acronym="Err" name="Error"/><terminator id="3" index="2" acronym="SE" name="SystemError"/></terminators><caching/></action><action xsi:type="compoundAction" id="40" name="GenerateTag" description="This test demonstrates EUTRA-IMS Mobile Terminated SMS with EUTRA-NR Measurements and ENDC split bearer addition, in particular the following operations: 1. LTE Attach on PDN1 with UE capability check for ENDC. 2. IMS Registration on PDN2 over IPv4/IPv6 and IPSEC ON/OFF (PDN Type and IPSEC configurable) 3. MT SMS over IPv4/IPv6. 4. ENDC addition - Move the default MCG bearer to an SCG bearer after NR measurement (MN terminated, FR1 Band). 5. SCG Release. 6. LTE Detach. 7. End of test."><action xsi:type="controlAction" id="0" name="Start" controlActionType="START"><outcome id="0" followingActionId="4" name=""/></action><action xsi:type="controlAction" id="1" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>1</id></parameter></action><action xsi:type="controlAction" id="2" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>2</id></parameter></action><action xsi:type="controlAction" id="3" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>3</id></parameter></action><action xsi:type="controlAction" id="4" name="Assignment" controlActionType="ASSIGNMENT"><parameter xsi:type="AssignmentType"><ControlVariableList xsi:type="ControlVariableListType"/><AssignmentExpressionList xsi:type="AssignmentExpressionListType"><AssignmentExpression xsi:type="ExpressionType">oTag = java(Math.getModuloValue(java(Math.rand(l_omitted)), 4294967295))</AssignmentExpression></AssignmentExpressionList></parameter><outcome id="1" followingActionId