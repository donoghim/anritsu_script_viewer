]]></Text><NoteLink anchorId="4" anchorIdType="1"><w x="682" y="-369"/><w x="481" y="-315"/></NoteLink></Note><Note x="-476" y="-887" width="571" height="845"><Text><![CDATA[Following parameters are initialized in the procedure:

Parameter        : User_Supplied_Sqn_Rand
Description       : Parameter controls whether the values of SQN and RAND are used defined or automatically generated
                           by library.
Possible values : True, False
Default value    : False		

Parameter        : EpsAttachResult
Description       : EPS attach result sent in the Attach Accept message. Value of "Auto" implies that UE requested attach 
                            type is accepted.
Possible values : EpsOnly, Combined, Auto
Default value    : Auto

Parameter        : BandIndicator
Description       : ECell Band indicator
Possible values : 
Default value    : 4

Parameter        : DLEarfcn
Description       : Downlink Earfcn value 
Possible values : 
Default value    : 2100

Parameter        : SQN
Description       : Sequence Number to be used in Authentication procedure. The parameter value is only used if
                           User_Supplied_Sqn_Rand is set to False
Possible values : 
Default value    : 000000000000

Parameter        : RAND
Description       : Random number to be used in Authentication procedure. The parameter value is only used if
                           User_Supplied_Sqn_Rand is set to False
Possible values : 
Default value    : 0123456789abcdef0123456789abcdef

Parameter        : K
Description       : Shared Secret  key to be used in Authentication procedure. 
Possible values : 
Default value    : 00112233445566778899aabbccddeeff

Parameter        : RRCintegrityAlgorithm
Description       : Integrity Algorithm to be used for RRC. 
Possible values : null, Snow3g, AES
Default value    : Snow3g

Parameter        : RRCcipheringAlgorithm
Description       : Ciphering Algorithm to be used for RRC. 
Possible values : null, Snow3g, AES
Default value    : null

Parameter        : NASintegrityAlgorithm
Description       : Integrity Algorithm to be used for NAS. 
Possible values : null, Snow3g, AES
Default value    : Snow3g

Parameter        : NAScipheringAlgorithm
Description       : Ciphering Algorithm to be used for NAS. 
Possible values : null, Snow3g, AES
Default value    : null]]></Text></Note></layoutInformation></displayInformation><parameter xsi:type="CompoundParametersType"><ParameterAssignment xsi:type="ParameterAssignmentType"><ParameterName readOnly="true" xsi:type="VariableNameView">Re_Regi_Timer_Short</ParameterName><ParameterValue default_able="true" variable_able="USER_VARIABLE" xsi:type=":string">600</ParameterValue></ParameterAssignment></parameter><outcome id="752" followingActionId="294" terminatorId="1"/><outcome id="753" followingActionId="-1" terminatorId="2"/><outcome id="754" followingActionId="-1" terminatorId="3"/><terminators><terminator id="1" index="0" acronym="End" name="End"/><terminator id="2" index="1" acronym="Err" name="Error"/><terminator id="3" index="2" acronym="SE" name="SystemError"/></terminators><caching/></action><action xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="compoundAction" id="298" name="InitialiseParameters" description="After successfull LTE attach, the network initiates a dedicated bearer establishment procedure. On successful completion of the dedicated bearer establishment procedure, data transfer is performed via default and dedicated bearer. "><action xsi:type="controlAction" id="0" name="Start" controlActionType="START"><outcome id="0" followingActionId="4" name=""/></action><action xsi:type="controlAction" id="2" name="CompoundTerminator" controlActionType="COMPOUND_TERMINATOR"><parameter xsi:type="CompoundTerminatorType"><id>1</id></parameter></action><action xsi:type="controlAction" id="4" name="Assignment" controlActionType="ASSIGNMENT"><parameter xsi:type="AssignmentType"><ControlVariableList xsi:type="ControlVariableListType"><ControlVariable xsi:type="VariableAssignmentType" name="RegExpiry_Short"><procedureLibrary>ImsSignalingLib</procedureLibrary><nodePath>Send200OK/response/value-/headers/value-/expires/value-/deltaSec</nodePath><defaultValue><Send200OK xsi:type="Send200OK_RtdParameter.type"><response><value-><headers><value-><expire